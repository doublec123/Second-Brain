{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "prisma generate --schema ./prisma/schema.prisma",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/second-brain\" --filter \"./artifacts/api-server\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@vercel/node": "^5.8.2",
    "dotenv": "^17.4.2",
    "prettier": "^3.8.1",
    "prisma": "^7.8.0",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/engines",
      "prisma"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.20.0"
  }
}
